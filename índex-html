public class CalculadoraLuisGustavo {

    private JFrame frmLuisGustavo;
    private JTextField JTFResultado;

    private double valor1;
    private String op;

    public static void main(String[] args) {
        EventQueue.invokeLater(new Runnable() {
            public void run() {
                try {
                    CalculadoraLuisGustavo window =
                        new CalculadoraLuisGustavo();
                    window.frmLuisGustavo.setVisible(true);
                } catch (Exception e) {
                    e.printStackTrace();
                }
            }
        });
    }

    public CalculadoraLuisGustavo() {
        initialize();
    }

    // MÉTODOS DA CALCULADORA

    public double adicao(double a, double b) {
        return a + b;
    }

    public double subtracao(double a, double b) {
        return a - b;
    }

    public double multiplicacao(double a, double b) {
        return a * b;
    }

    public double divisao(double a, double b) {
        if (b == 0) {
            throw new ArithmeticException("Divisão por zero!");
        }
        return a / b;
    }

    public double potencia(double a, double b) {
        return Math.pow(a, b);
    }

    private void escolherOperacao(String operacao) {
        try {
            valor1 = Double.parseDouble(JTFResultado.getText());
            op = operacao;
            JTFResultado.setText("");
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(frmLuisGustavo,
                "Digite um número primeiro!");
        }
    }

    private void adicionarNumero(String numero) {
        JTFResultado.setText(
            JTFResultado.getText() + numero
        );
    }

    private void calcular() {
        try {
            double valor2 =
                Double.parseDouble(JTFResultado.getText());

            double resultado = 0;

            switch (op) {
                case "soma":
                    resultado = adicao(valor1, valor2);
                    break;

                case "subtracao":
                    resultado = subtracao(valor1, valor2);
                    break;

                case "multiplicacao":
                    resultado = multiplicacao(valor1, valor2);
                    break;

                case "divisao":
                    resultado = divisao(valor1, valor2);
                    break;

                case "potencia":
                    resultado = potencia(valor1, valor2);
                    break;

                default:
                    return;
            }

            JTFResultado.setText(String.valueOf(resultado));

        } catch (ArithmeticException e) {
            JOptionPane.showMessageDialog(frmLuisGustavo,
                e.getMessage());
            JTFResultado.setText("0");

        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(frmLuisGustavo,
                "Digite o segundo número!");
        }
    }

